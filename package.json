{
  "name": "cloud-cost-optimizer",
  "version": "1.0.0",
  "description": "Cloud cost optimization application",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
